<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapExploreFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar (back + title) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:background="#66000000">

        <ImageButton
            android:id="@+id/btnBackMap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@android:color/white"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gợi ý địa điểm"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvMapPlaceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 địa điểm"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:alpha="0.95" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search + category filters -->
    <LinearLayout
        android:id="@+id/mapSearchFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="76dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/slate_400" />

            <EditText
                android:id="@+id/etSearchMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Tìm kiếm địa điểm..."
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="15sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPoiFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPoiAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="ALL"
                    android:text="Tất cả"
                    android:checked="true"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:chipIcon="@drawable/ic_filter_all"
                    app:chipIconVisible="true"
                    app:chipIconTint="@color/filter_chip_icon_tint"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPoiCafe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="Cafe"
                    android:text="Cafe"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:chipIcon="@drawable/ic_filter_cafe"
                    app:chipIconVisible="true"
                    app:chipIconTint="@color/filter_chip_icon_tint"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPoiRestaurant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="Restaurant"
                    android:text="Nhà hàng"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:chipIcon="@drawable/ic_filter_restaurant"
                    app:chipIconVisible="true"
                    app:chipIconTint="@color/filter_chip_icon_tint"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPoiEntertainment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="Nightlife"
                    android:text="Giải trí"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:chipIcon="@drawable/ic_filter_entertainment"
                    app:chipIconVisible="true"
                    app:chipIconTint="@color/filter_chip_icon_tint"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPoiCulture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="CULTURE"
                    android:text="Văn hoá"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:chipIcon="@drawable/ic_filter_culture"
                    app:chipIconVisible="true"
                    app:chipIconTint="@color/filter_chip_icon_tint"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPoiNature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="NATURE"
                    android:text="Thiên nhiên"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_background"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:chipIcon="@drawable/ic_filter_nature"
                    app:chipIconVisible="true"
                    app:chipIconTint="@color/filter_chip_icon_tint"
                    app:checkedIconVisible="false" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Floating Search Suggestions Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearchSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="136dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:strokeColor="#E5E7EB"
        app:strokeWidth="1dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchAutoComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="220dp"
            android:padding="4dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Zoom controls container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="256dp"
        android:orientation="vertical">

        <!-- Zoom In Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_zoom_in"
            app:fabSize="mini"
            app:backgroundTint="@android:color/white"
            app:tint="#111827"
            android:contentDescription="Zoom In" />

        <!-- Zoom Out Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_zoom_out"
            app:fabSize="mini"
            app:backgroundTint="@android:color/white"
            app:tint="#111827"
            android:contentDescription="Zoom Out" />
    </LinearLayout>

    <!-- Bottom suggestion panel -->
    <LinearLayout
        android:id="@+id/panelPoiSuggestions"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#CCFFFFFF"
        android:paddingTop="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Địa điểm đề xuất"
            android:textColor="@color/emerald_700"
            android:textStyle="bold"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPoiSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</FrameLayout>

