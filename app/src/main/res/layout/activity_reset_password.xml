<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_auth"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/llBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/emerald_600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quay lại"
                android:textColor="@color/emerald_600"
                android:layout_marginStart="4dp"
                android:textSize="16sp"/>
        </LinearLayout>

        <View
            android:id="@+id/vResetBg"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_emerald_light_rounded"
            app:layout_constraintTop_toBottomOf="@id/llBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_partial_secure"
            app:tint="@color/emerald_600"
            app:layout_constraintTop_toTopOf="@id/vResetBg"
            app:layout_constraintBottom_toBottomOf="@id/vResetBg"
            app:layout_constraintStart_toStartOf="@id/vResetBg"
            app:layout_constraintEnd_toEndOf="@id/vResetBg" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mật khẩu mới"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/slate_800"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/vResetBg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vui lòng tạo mật khẩu mạnh để bảo vệ tài khoản"
            android:textColor="@color/slate_500"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <RelativeLayout
            android:id="@+id/rlNewPass"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_input_auth"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvInstruction">

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Mật khẩu mới"
                android:paddingStart="20dp"
                android:paddingEnd="50dp"
                android:inputType="textPassword"
                android:textColor="@color/slate_800"
                android:textColorHint="@color/slate_400" />

            <ImageView
                android:id="@+id/ivToggleNewPass"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/slate_400"
                android:contentDescription="Hiện/ẩn mật khẩu"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlConfirmPass"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_auth"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/rlNewPass">

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Xác nhận mật khẩu"
                android:paddingStart="20dp"
                android:paddingEnd="50dp"
                android:inputType="textPassword"
                android:textColor="@color/slate_800"
                android:textColorHint="@color/slate_400" />

            <ImageView
                android:id="@+id/ivToggleConfirmPass"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/slate_400"
                android:contentDescription="Hiện/ẩn mật khẩu"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_gradient_rounded"
            android:text="Cập nhật mật khẩu"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/rlConfirmPass" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>