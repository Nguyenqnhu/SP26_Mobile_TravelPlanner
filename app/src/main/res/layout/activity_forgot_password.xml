<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_auth"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/llBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/emerald_600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quay lại"
                android:textColor="@color/emerald_600"
                android:layout_marginStart="4dp"
                android:textSize="16sp"/>
        </LinearLayout>

        <View
            android:id="@+id/vKeyBg"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_emerald_light_rounded"
            app:layout_constraintTop_toBottomOf="@id/llBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" /> <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_lock_idle_lock"
        app:tint="@color/emerald_600"
        app:layout_constraintTop_toTopOf="@id/vKeyBg"
        app:layout_constraintBottom_toBottomOf="@id/vKeyBg"
        app:layout_constraintStart_toStartOf="@id/vKeyBg"
        app:layout_constraintEnd_toEndOf="@id/vKeyBg" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            app:tint="@color/emerald_600"
            app:layout_constraintTop_toTopOf="@id/vKeyBg"
            app:layout_constraintBottom_toBottomOf="@id/vKeyBg"
            app:layout_constraintStart_toStartOf="@id/vKeyBg"
            app:layout_constraintEnd_toEndOf="@id/vKeyBg" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quên mật khẩu"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/slate_800"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/vKeyBg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" /> <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhập email để nhận mã xác thực"
        android:textColor="@color/slate_500"
        android:layout_marginTop="8dp"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etEmailForgot"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_input_auth"
            android:hint="Email"
            android:paddingStart="20dp"
            android:inputType="textEmailAddress"
            android:textColor="@color/slate_800"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvInstruction" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_gradient_rounded"
            android:text="Gửi mã OTP"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/etEmailForgot" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/btnSendOtp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhớ mật khẩu rồi? "
                android:textColor="@color/slate_500" />

            <TextView
                android:id="@+id/tvGoBackLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng nhập ▶"
                android:textColor="@color/emerald_600"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>