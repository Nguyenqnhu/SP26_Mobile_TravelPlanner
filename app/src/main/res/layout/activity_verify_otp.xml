<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_auth"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/llBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/emerald_600" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quay lại"
                android:textColor="@color/emerald_600"
                android:layout_marginStart="4dp"
                android:textSize="16sp"/>
        </LinearLayout>

        <View
            android:id="@+id/vShieldBg"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_emerald_light_rounded"
            app:layout_constraintTop_toBottomOf="@id/llBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="@color/white"
            app:layout_constraintTop_toTopOf="@id/vShieldBg"
            app:layout_constraintBottom_toBottomOf="@id/vShieldBg"
            app:layout_constraintStart_toStartOf="@id/vShieldBg"
            app:layout_constraintEnd_toEndOf="@id/vShieldBg" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xác thực OTP"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/slate_800"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/vShieldBg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Nhập mã 6 số đã gửi đến email của bạn"
            android:textColor="@color/slate_500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <LinearLayout
            android:id="@+id/llOtpContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvInstruction">

            <EditText android:id="@+id/otp1" style="@style/OtpInputStyle" />
            <EditText android:id="@+id/otp2" style="@style/OtpInputStyle" />
            <EditText android:id="@+id/otp3" style="@style/OtpInputStyle" />
            <EditText android:id="@+id/otp4" style="@style/OtpInputStyle" />
            <EditText android:id="@+id/otp5" style="@style/OtpInputStyle" />
            <EditText android:id="@+id/otp6" style="@style/OtpInputStyle" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_gradient_rounded"
            android:text="Xác nhận"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/llOtpContainer" /> <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnVerify"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa nhận được mã? "
            android:textColor="@color/slate_500" />

        <TextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gửi lại"
            android:textColor="@color/emerald_600"
            android:textStyle="bold" />
    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>