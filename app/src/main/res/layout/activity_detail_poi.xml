<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Hero image -->
    <ImageView
        android:id="@+id/imgHero"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="centerCrop"
        android:src="@drawable/sampleplace3" />

    <!-- Scrollable white content on top of image -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- khoảng trống để lộ phần ảnh -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="170dp" />

            <!-- White content card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_detail_white_top"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">


                <!-- Name + price + like -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:text="Tên địa điểm"
                        android:textColor="#111827"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Miễn phí"
                        android:textColor="#10B981"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- City -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_pin"
                        app:tint="#10B981" />

                    <TextView
                        android:id="@+id/txtCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Singapore"
                        android:textColor="#6B7280"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtTypeChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:paddingStart="14dp"
                            android:paddingTop="9dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="9dp"
                            android:text="Giải trí"
                            android:textColor="#0F766E"
                            android:textSize="13sp" />
                        <!-- android:background="@drawable/bg_chip_light_green"-->

                        <TextView
                            android:id="@+id/txtIndoorChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:paddingStart="14dp"
                            android:paddingTop="9dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="9dp"
                            android:text="Trong nhà"
                            android:textColor="@android:color/white"
                            android:textSize="13sp" />
                        <!--android:background="@drawable/bg_chip_orange"-->

                        <TextView
                            android:id="@+id/txtHoursChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="14dp"
                            android:paddingTop="9dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="9dp"
                            android:text="00:00 - 23:59"
                            android:textColor="#6B7280"
                            android:textSize="13sp" />
<!-- android:background="@drawable/bg_chip_gray"-->
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"
                        android:text="Mô tả"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="28dp"
                        android:paddingBottom="12dp"
                        android:text="Đánh giá"
                        android:textColor="#9CA3AF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/tabIndicator"
                    android:layout_width="74dp"
                    android:layout_height="3dp"
                    android:background="#10B981" />

                <!-- Description -->
                <LinearLayout
                    android:id="@+id/layoutDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="Mô tả địa điểm..."
                        android:textColor="#6B7280"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/layoutAddressBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_detail_button"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_pin"
                            app:tint="#10B981" />

                        <TextView
                            android:id="@+id/txtAddress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="Địa chỉ"
                            android:textColor="#6B7280"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Review -->
                <LinearLayout
                    android:id="@+id/layoutReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="28dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa có đánh giá nào"
                        android:textColor="#6B7280"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_detail_button"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_left"
        android:tint="#111827"
        android:contentDescription="Back" />

    <!-- Like button -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnLike"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_detail_button"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_heart"
        android:tint="#F87171"
        android:contentDescription="Like" />

</FrameLayout>