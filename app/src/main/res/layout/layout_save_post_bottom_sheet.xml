<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_white"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <!-- Handle bar at the top -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:background="#D1D5DB" />

    <!-- Save Option Row -->
    <LinearLayout
        android:id="@+id/btnOptionSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/imgOptionSaveIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/saved_button"
            app:tint="@color/slate_800" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOptionSaveTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lưu mã giảm"
                android:textColor="@color/slate_800"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOptionSaveDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lưu ưu đãi này vào mục tài khoản cá nhân"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
