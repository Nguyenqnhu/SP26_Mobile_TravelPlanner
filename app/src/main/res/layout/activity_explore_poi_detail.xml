<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Ảnh cover -->
    <ImageView
        android:id="@+id/ivPoiDetailImage"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_image_placeholder"
        android:contentDescription="Ảnh địa điểm" />

    <!-- Back button nổi trên ảnh -->
    <ImageButton
        android:id="@+id/btnBackDetail"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_white"
        android:elevation="6dp"
        android:src="@drawable/ic_left"
        android:padding="10dp"
        app:tint="@color/slate_800"
        android:contentDescription="Quay lại" />

    <!-- Khung trắng đè lên ảnh, bo góc trên -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="300dp"
        android:background="@drawable/bg_detail_white_top"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <!-- Name + cost (trên cùng khung trắng) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPoiDetailName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tên địa điểm"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/slate_800"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvPoiDetailCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa cập nhật"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/emerald_700" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPoiDetailCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Thành phố"
                android:textSize="14sp"
                android:textColor="@color/slate_500" />

            <TextView
                android:id="@+id/tvPoiDetailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Địa chỉ"
                android:textSize="13sp"
                android:textColor="@color/slate_500" />

            <!-- Badge giờ mở cửa + indoor/outdoor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPoiDetailHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_type_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="Giờ mở cửa"
                    android:textColor="@color/slate_800"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPoiDetailIndoor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_type_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="Trong/Ngoài"
                    android:textColor="@color/slate_800"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Gợi ý"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/slate_800" />

            <TextView
                android:id="@+id/tvPoiDetailRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Nội dung gợi ý"
                android:textSize="13sp"
                android:textColor="@color/slate_500" />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenMap"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/button_green_gradient"
                android:text="Mở Google Maps"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/white" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

