<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- The Map View -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapSelectRoute"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="18dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        android:background="#E60F2B1D"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackSelectRoute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_emerald_light_rounded"
            android:src="@drawable/ic_left"
            app:tint="@color/heading_dark_green"
            android:padding="8dp"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lựa chọn tuyến đường"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:shadowColor="#80000000"
                android:shadowRadius="3"
                android:shadowDx="1"
                android:shadowDy="1" />

            <TextView
                android:id="@+id/tvSelectRouteSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khám phá các tuyến đường tối ưu"
                android:textColor="#F3F4F6"
                android:textSize="13sp"
                android:shadowColor="#80000000"
                android:shadowRadius="3"
                android:shadowDx="1"
                android:shadowDy="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Map Zoom controls overlay (bottom right above bottom card) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="250dp"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomInSelectRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_zoom_in"
            app:fabSize="mini"
            app:backgroundTint="@android:color/white"
            app:tint="#111827"
            android:contentDescription="Zoom In" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomOutSelectRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_zoom_out"
            app:fabSize="mini"
            app:backgroundTint="@android:color/white"
            app:tint="#111827"
            android:contentDescription="Zoom Out" />
    </LinearLayout>

    <!-- Bottom Route Card Selection Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRoutePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvRouteSelectHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Các tuyến đường gợi ý"
                android:textColor="@color/heading_dark_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Horizontal Scroll of Route Option selectors -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutRouteOptionsList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Detailed Selected Route Info -->
            <LinearLayout
                android:id="@+id/layoutSelectedRouteDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvDetailRouteName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tuyến đường 1"
                        android:textColor="@color/text_title"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailRouteDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="-- km"
                        android:textColor="@color/emerald_700"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvDetailRouteNodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Đi qua: --"
                    android:textColor="@color/text_body"
                    android:textSize="13sp" />

                <!-- Weather Summary -->
                <LinearLayout
                    android:id="@+id/layoutWeatherSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_cloud"
                        app:tint="@color/emerald_700" />

                    <TextView
                        android:id="@+id/tvDetailRouteWeatherSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Thời tiết: --"
                        android:textColor="@color/text_body"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- AI Advice & Warnings Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAdvice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/mint_bg_light"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/partner_border"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_bell"
                                app:tint="@color/emerald_700" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Khuyến nghị từ AI"
                                android:textColor="@color/heading_dark_green"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetailRouteAdvice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Đang lấy lời khuyên từ AI..."
                            android:textColor="@color/text_body"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:id="@+id/tvDetailRouteWarnings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text=""
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:textStyle="italic"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <ProgressBar
                    android:id="@+id/pbAdviceLoading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:indeterminateTint="@color/green_primary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Confirm Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplySelectedRoute"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Chọn tuyến đường"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/green_primary"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Global Loading Overlay -->
    <LinearLayout
        android:id="@+id/layoutSelectRouteLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/green_primary" />

        <TextView
            android:id="@+id/tvSelectRouteLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Đang tải các tuyến đường có sẵn..."
            android:textColor="@color/text_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Vui lòng chờ trong giây lát"
            android:textColor="@color/slate_500"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
