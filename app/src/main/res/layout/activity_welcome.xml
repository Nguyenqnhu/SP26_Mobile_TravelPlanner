<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_bg_gradient"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivFloatingMap"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_mylocation"
        app:tint="@color/rose_400"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="60dp"
        android:layout_marginStart="20dp" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_compass"
        app:tint="@color/violet_400"
        android:alpha="0.5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="30dp" />

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_gradient_rounded"
            android:padding="20dp"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/white"
            android:elevation="12dp" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TravelGo"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khám phá thế giới cùng bạn"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="48dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Đăng nhập"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:background="@drawable/bg_gradient_rounded"
            android:elevation="4dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Đăng ký"
            android:textColor="@color/text_main"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="17sp"
            android:background="@drawable/bg_outline_rounded" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-10dp">

        <View android:layout_width="40dp" android:layout_height="80dp"
            android:background="@color/amber_400" android:alpha="0.7" android:layout_margin="4dp"/>
        <View android:layout_width="40dp" android:layout_height="60dp"
            android:background="@color/emerald_400" android:alpha="0.7" android:layout_margin="4dp"/>
        <View android:layout_width="40dp" android:layout_height="100dp"
            android:background="@color/light_blue_pastel" android:alpha="0.7" android:layout_margin="4dp"/>
        <View android:layout_width="40dp" android:layout_height="70dp"
            android:background="@color/rose_400" android:alpha="0.7" android:layout_margin="4dp"/>
        <View android:layout_width="40dp" android:layout_height="85dp"
            android:background="@color/violet_400" android:alpha="0.7" android:layout_margin="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>