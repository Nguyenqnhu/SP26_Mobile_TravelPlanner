<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="140dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_partner_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtPartnerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vietravel"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPartnerDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tour du lịch chất lượng cao"
        android:textColor="#E5E7EB"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtPartnerDiscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_discount_pill"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="Giảm 20%"
        android:textColor="#111827"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>