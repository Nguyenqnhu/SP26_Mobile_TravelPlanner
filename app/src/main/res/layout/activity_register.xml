<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_auth"
    android:fillViewport="true"
    tools:context=".ui.RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_gradient_rounded"
                android:padding="20dp"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@color/white"
                android:elevation="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TravelGo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/slate_800"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/llHeader">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng ký"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/slate_800" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập thông tin của bạn để tiếp tục"
                android:textColor="@color/slate_500"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giới tính"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/slate_800" />

            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">
                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nam"
                    android:checked="true"
                    android:buttonTint="@color/emerald_600"
                    android:textColor="@color/slate_800"
                    android:layout_marginEnd="24dp" />
                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/emerald_600"
                    android:text="Nữ"
                    android:textColor="@color/slate_800" />
            </RadioGroup>

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_auth"
                android:hint="Họ và tên"
                android:paddingStart="20dp"
                android:textColorHint="@color/slate_400"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_auth"
                android:hint="Email"
                android:paddingStart="20dp"
                android:textColorHint="@color/slate_400"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_auth"
                android:layout_marginBottom="12dp"
                android:elevation="2dp">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Mật khẩu"
                android:paddingStart="20dp"
                android:paddingEnd="50dp"
                android:textColorHint="@color/slate_400"
                android:inputType="textPassword"/>

            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/slate_400"
                android:contentDescription="Hiện/ẩn mật khẩu"
                android:clickable="true"
                android:focusable="true"/>
            </RelativeLayout>

            <EditText
                android:id="@+id/etDateOfBirth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_auth"
                android:hint="Ngày sinh"
                android:paddingStart="20dp"
                android:focusable="false"
                android:clickable="true"
                android:textColorHint="@color/slate_400"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"/>

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_auth"
                android:hint="Số điện thoại"
                android:paddingStart="20dp"
                android:textColorHint="@color/slate_400"
                android:inputType="phone"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"/>

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_auth"
                android:hint="Địa chỉ"
                android:paddingStart="20dp"
                android:textColorHint="@color/slate_400"
                android:inputType="textPostalAddress"
                android:layout_marginBottom="24dp"
                android:elevation="2dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_gradient_rounded"
                android:text="Đăng ký"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:elevation="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/llForm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có tài khoản? "
                android:textColor="@color/slate_500"/>
            <TextView
                android:id="@+id/tvLoginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng nhập ▶"
                android:textColor="@color/emerald_600"
                android:textStyle="bold"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>